# Server Configuration
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=replace-with-appwrite-project-id
